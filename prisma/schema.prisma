  status             String   @default("DRAFT") // DRAFT, OPEN, ATTENDANCE_UPLOADED, ATTENDANCE_VALIDATED, PAYROLL_COMPUTED, FOR_REVIEW, REVIEWED, FOR_APPROVAL, APPROVED, RELEASED, LOCKED, CANCELLED

