model Payroll {
  id       String @id @default(cuid())
  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  compensationType String @default("DAILY") // DAILY, MONTHLY, HOURLY, PER_PIECE, PER_LOT, FREELANCE, PROJECT_BASED
  rate             Float  @default(0)

  // Computed Time
  daysWorked    Float @default(0)
  regularHours  Float @default(0)
  overtimeHours Float @default(0)

  // Earnings
  basicPay             Float @default(0)
  overtimePay          Float @default(0)
  nightDiffPay         Float @default(0)
  holidayPay           Float @default(0)
  restDayPay           Float @default(0)
  allowances           Float @default(0)
  nonTaxableAllowances Float @default(0)
  otherEarnings        Float @default(0)
  grossPay             Float @default(0)
  grossTaxablePay      Float @default(0) // Derived

  // Statutory Deductions
  sssDeduction         Float @default(0)
  sssEmployerShare     Float @default(0)
  sssEcEmployerShare   Float @default(0)
  sssWispDeduction     Float @default(0)
  sssWispEmployerShare Float @default(0)

  philhealthDeduction     Float @default(0)
  philhealthEmployerShare Float @default(0)

  pagibigDeduction     Float @default(0)
  pagibigEmployerShare Float @default(0)

  // Tax Deductions
  taxableCompensation Float   @default(0)
  birPayrollFrequency String?
  birEffectiveYear    Int?
  birBracketNo        Int?
  birBaseTax          Float?
  birTaxRatePercent   Float?
  birExcessOver       Float?
  withholdingTax      Float   @default(0) // Computed
  manualTaxAdjustment Float   @default(0) // Manual Override
  finalWithholdingTax Float   @default(0) // Computed + Override

  cashAdvance         Float @default(0)
  loanDeduction       Float @default(0)
  otherDeductions     Float @default(0)
  lateUndertimeAmount Float @default(0)
  totalDeductions     Float @default(0)

  // Final
  netPay  Float   @default(0)
  remarks String?

  // Payment Status & Exceptions
  paymentMethod        String? // GCash Only, Bank Transfer Only
  paymentStatus        String  @default("PENDING") // PENDING, ON_HOLD, EXCEPTION, PAID, FAILED
  paymentHoldReason    String?
  paymentBatchId       String?
  transactionReference String?

  paymentBatchRows PaymentBatchRow[]

  earnings   PayrollEarning[]
  deductions PayrollDeduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, payrollPeriodId])
}

