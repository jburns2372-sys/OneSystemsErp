// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          String    @default("PROJECT_ENGINEER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  managedProjects Project[] @relation("ProjectManager")

  materialRequests   MaterialRequest[] @relation("RequestedBy")
  checkedMRs         MaterialRequest[] @relation("CheckedBy")
  approvedMRs        MaterialRequest[] @relation("ApprovedBy")
  preparedMRs        MaterialRequest[] @relation("PreparedBy")
  expenses           Expense[]         @relation("ExpenseLoggedBy")
  uploadedDocs       Document[]        @relation("DocumentUploader")
  deliveriesReceived Delivery[]        @relation("DeliveryReceiver")
  verifiedDeliveries Delivery[]        @relation("DeliveryVerifier")
  reviewedDeliveries Delivery[]        @relation("DeliveryReviewer")
  approvedDeliveries Delivery[]        @relation("DeliveryApprover")
  consumptionsLogged ConsumptionLog[]

  misCreated   MaterialIssuance[] @relation("MISForeman")
  misProcessed MaterialIssuance[] @relation("MISWarehouseman")
  misApproved  MaterialIssuance[] @relation("MISAccountant")
  misReleased  MaterialIssuance[] @relation("MISReleaser")

  mrsCreated   MaterialReturn[] @relation("MRSForeman")
  mrsProcessed MaterialReturn[] @relation("MRSWarehouseman")

  pcCustodians PettyCashAccount[] @relation("PCCustodian")
  pcApprovers  PettyCashAccount[] @relation("PCApprover")
  pcReviewers  PettyCashAccount[] @relation("PCReviewer")

  // HR & Payroll Relations
  encodedDtrs         DailyTimeRecord[] @relation("DtrEncoder")
  createdPayrolls     PayrollPeriod[]   @relation("PayrollCreator")
  approvedPayrolls    PayrollPeriod[]   @relation("PayrollApprover")
  approvedDeductions  DeductionLedger[] @relation("DeductionApprover")
  payrollApproverLogs PayrollApproval[] @relation("PayrollApproverLog")

  // Added Workflow Relations
  preparedPOs                 PurchaseOrder[]             @relation("POPreparedBy")
  reviewedPOs                 PurchaseOrder[]             @relation("POReviewedBy")
  approvedPOs                 PurchaseOrder[]             @relation("POApprovedBy")
  reviewedExpenses            Expense[]                   @relation("ExpenseReviewedBy")
  approvedExpenses            Expense[]                   @relation("ExpenseApprovedBy")
  uploadedProofFiles          ExpenseProofFile[]          @relation("ExpenseProofUploadedBy")
  verifiedProofFiles          ExpenseProofFile[]          @relation("ExpenseProofVerifiedBy")
  approvalActions             ExpenseApprovalLog[]        @relation("ExpenseApprovalActionBy")
  uploadedWorkerDocs          WorkerDocument[]            @relation("WorkerDocumentUploader")
  uploadedTemplates           DocumentTemplate[]          @relation("DocumentTemplateUploader")
  uploadedAccomplishmentFiles ProjectAccomplishmentFile[] @relation("AccomplishmentFileUploader")
  projectAccomplishmentFiles  ProjectAccomplishmentFile[]
}

model SystemRole {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Project {
  id                         String    @id @default(cuid())
  name                       String
  description                String?
  location                   String?
  startDate                  DateTime?
  endDate                    DateTime?
  status                     String    @default("PLANNING")
  // Financial & Billing Fields
  contractAmountVATInclusive Boolean   @default(true)
  vatRate                    Float     @default(12.0)
  retentionPercentage        Float     @default(10.0)
  withholdingTaxPercentage   Float     @default(2.0)
  mobilizationAdvanceAmount  Float     @default(0)
  advanceRecoupmentMethod    String    @default("PRO_RATA")
  liquidatedDamagesRate      Float     @default(0.1)
  otherDeductions            Float     @default(0)
  paymentTerms               String?
  boqLocked                  Boolean   @default(false)
  consolidatedBOQLocked      Boolean   @default(false)

  // Additional Fields
  contractNumber           String?
  client                   String?
  contractor               String?
  gpsLatitude              Float?
  gpsLongitude             Float?
  acceptableGeotagRadius   Float     @default(100)
  projectCategory          String?
  fundingSource            String?
  contractAmount           Float     @default(0)
  originalContractDuration Int?
  noticeToProceedDate      DateTime?
  originalCompletionDate   DateTime?
  revisedCompletionDate    DateTime?
  implementingOffice       String?

  // Relations
  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  awardedBoqItems      AwardedBOQItem[]
  consolidatedBoqItems ConsolidatedBOQItem[]
  materialRequests     MaterialRequest[]
  expenses             Expense[]
  pettyCashAccounts    PettyCashAccount[]
  workers              Worker[]              @relation("ProjectWorkers")
  documents            Document[]
  documentTemplates    DocumentTemplate[]
  consumptions         ConsumptionLog[]
  issuances            MaterialIssuance[]
  materialReturns      MaterialReturn[]
  dtrs                 DailyTimeRecord[]
  payrollPeriods       PayrollPeriod[]
  payrolls             Payroll[]

  // New Accomplishment and Billing Relations
  accomplishments     Accomplishment[]
  billings            Billing[]
  variationOrders     VariationOrder[]
  evidenceFiles       EvidenceFile[]
  projectCameras      ProjectCamera[]
  aiValidationRuns    AIValidationRun[]
  subcontractPackages SubcontractPackage[]
  jobOrders           JobOrder[]
  subcontractBillings SubcontractBilling[]
  backCharges         BackCharge[]

  knowledgeReferences KnowledgeReference[]

  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  projectAccomplishmentFiles      ProjectAccomplishmentFile[]
  projectAccomplishmentAIFindings ProjectAccomplishmentAIFinding[]
}

model AwardedBOQItem {
  id               String  @id @default(cuid())
  itemCode         String
  category         String?
  description      String
  unit             String
  quantity         Float
  directCost       Float   @default(0)
  indirectCost     Float   @default(0)
  combinedUnitCost Float   @default(0)
  totalCost        Float

  // Accomplishment & Billing Tracking
  previousQuantityAccomplished Float @default(0)
  currentQuantityAccomplished  Float @default(0)
  totalQuantityAccomplished    Float @default(0)
  remainingQuantity            Float @default(0)
  percentageAccomplished       Float @default(0)
  amountAccomplished           Float @default(0)
  balanceAmount                Float @default(0)

  // Internal Tracking (Rule 16)
  actualOrderedQuantity          Float  @default(0)
  actualDeliveredQuantity        Float  @default(0)
  actualInstalledQuantity        Float  @default(0)
  finalApprovedInstalledQuantity Float?
  materialSavingsQuantity        Float  @default(0)
  materialSavingsAmount          Float  @default(0)
  wastageQuantity                Float  @default(0)
  actualCost                     Float  @default(0)
  costVariance                   Float  @default(0)

  aiValidationRequired Boolean @default(true)
  requiredEvidenceType String? // PHOTOS, VIDEOS, DOCUMENTS
  status               String  @default("PENDING")

  processingType String @default("MATERIAL_EQUIPMENT") // MATERIAL_EQUIPMENT, EXPENSE_BASED, MILESTONE_BASED, HYBRID

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  mappings BOQMapping[]

  // New Accomplishment and Billing Relations
  lotBreakdowns       BOQLotBreakdown[]
  accomplishmentItems AccomplishmentItem[]
  billingItems        BillingItem[]
  variationOrders     VariationOrder[]
  evidenceFiles       EvidenceFile[]
  aiValidationRuns    AIValidationRun[]

  expenses              Expense[]
  pettyCashExpenses     PettyCashExpense[]
  subcontractorBOQItems SubcontractorBOQItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsolidatedBOQItem {
  id          String  @id @default(cuid())
  itemCode    String
  category    String?
  description String
  unit        String
  quantity    Float
  unitCost    Float
  totalCost   Float

  status String @default("PENDING")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  deliveredQty Float @default(0)
  consumedQty  Float @default(0)

  // Procurement Relations
  mrItems          MaterialRequestItem[]
  poItems          PurchaseOrderItem[]
  deliveryItems    DeliveryItem[]
  consumptionItems ConsumptionItem[]
  issuanceItems    IssuanceItem[]
  returnItems      ReturnItem[]

  mappings          BOQMapping[]
  expenses          Expense[]
  pettyCashExpenses PettyCashExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BOQMapping {
  id                   String  @id @default(cuid())
  mappingType          String // ONE_TO_ONE, ONE_TO_MANY, MANY_TO_ONE
  allocationPercentage Float?
  allocationQuantity   Float?
  remarks              String?
  aiConfidenceScore    Float?
  status               String  @default("APPROVED") // PENDING_AI, APPROVED, REJECTED

  awardedBoqItemId String
  awardedBoqItem   AwardedBOQItem @relation(fields: [awardedBoqItemId], references: [id], onDelete: Cascade)

  consolidatedBoqItemId String
  consolidatedBoqItem   ConsolidatedBOQItem @relation(fields: [consolidatedBoqItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id            String  @id @default(cuid())
  name          String
  tin           String?
  contactPerson String?
  contactNumber String?
  email         String?
  address       String?
  paymentTerms  String?
  website       String?
  plantLocation String?
  isVatable     Boolean @default(true)

  purchaseOrders  PurchaseOrder[]
  accountsPayable AccountsPayable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialRequest {
  id       String @id @default(cuid())
  mrNumber String @unique
  status   String @default("DRAFT") // DRAFT, AI_CHECKING, SUBMITTED, FOR_REVIEW, RETURNED, APPROVED, REJECTED, PARTIALLY_PROCURED, FULLY_PROCURED, CLOSED

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  requesterId String
  requester   User   @relation("RequestedBy", fields: [requesterId], references: [id])

  preparerId String?
  preparer   User?   @relation("PreparedBy", fields: [preparerId], references: [id])

  checkerId String?
  checker   User?   @relation("CheckedBy", fields: [checkerId], references: [id])

  approverId String?
  approver   User?   @relation("ApprovedBy", fields: [approverId], references: [id])

  // MRF Details
  purpose       String?
  priority      String  @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  locationOfUse String?
  remarks       String?

  aiValidationRisk  String? // Flags over-ordering or duplicate requests
  aiValidationNotes String? // Detailed AI check notes

  items          MaterialRequestItem[]
  purchaseOrders PurchaseOrder[]

  dateNeeded DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MaterialRequestItem {
  id               String @id @default(cuid())
  quantity         Float
  approvedQuantity Float?
  breakdownData    Json?

  mrId String
  mr   MaterialRequest @relation(fields: [mrId], references: [id], onDelete: Cascade)

  consolidatedBoqItemId String
  consolidatedBoqItem   ConsolidatedBOQItem @relation(fields: [consolidatedBoqItemId], references: [id])
}

model PurchaseOrder {
  id       String @id @default(cuid())
  poNumber String @unique
  status   String @default("DRAFT") // DRAFT, ISSUED, DELIVERED, PAID

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  mrId String
  mr   MaterialRequest @relation(fields: [mrId], references: [id])

  items      PurchaseOrderItem[]
  deliveries Delivery[]
  payables   AccountsPayable[]

  totalAmount      Float     @default(0)
  netAmount        Float     @default(0)
  vatAmount        Float     @default(0)
  deliveryDate     DateTime?
  paymentTermsDays Int?
  dueDate          DateTime?

  // Workflow Approval Rules (Rule 25.B)
  preparerId String?
  preparer   User?   @relation("POPreparedBy", fields: [preparerId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("POReviewedBy", fields: [reviewerId], references: [id])

  approverId String?
  approver   User?   @relation("POApprovedBy", fields: [approverId], references: [id])

  aiValidationRisk String? // Flags unusual pricing or remaining BOQ mismatch

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id       String @id @default(cuid())
  quantity Float
  unitCost Float

  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  consolidatedBoqItemId String
  consolidatedBoqItem   ConsolidatedBOQItem @relation(fields: [consolidatedBoqItemId], references: [id])
}

model Expense {
  id                   String   @id @default(cuid())
  amount               Float
  totalBreakdownAmount Float    @default(0)
  date                 DateTime
  category             String // e.g., MATERIALS, RENTAL, CONSUMABLES, OVERHEAD
  description          String
  receiptRef           String?
  supplierName         String?
  isAccrued            Boolean  @default(false)
  netAmount            Float    @default(0)
  vatAmount            Float    @default(0)
  billingEligibility   String   @default("BILLABLE") // BILLABLE, NON_BILLABLE, FOR_VALIDATION, FOR_VARIATION
  status               String   @default("DRAFT")
  aiValidationStatus   String?
  approvalStatus       String?
  aiValidationRisk     String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  loggedById String
  loggedBy   User   @relation("ExpenseLoggedBy", fields: [loggedById], references: [id])

  costType String @default("DIRECT") // DIRECT, INDIRECT, GENERAL, TEMPORARY, REIMBURSABLE

  awardedBoqItemId String?
  awardedBoqItem   AwardedBOQItem? @relation(fields: [awardedBoqItemId], references: [id])

  consolidatedBoqItemId String?
  consolidatedBoqItem   ConsolidatedBOQItem? @relation(fields: [consolidatedBoqItemId], references: [id])

  breakdownItems ExpenseBreakdownItem[]
  proofFiles     ExpenseProofFile[]
  aiValidation   ExpenseAIValidation?
  approvalLogs   ExpenseApprovalLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pettyCashExpense PettyCashExpense?

  // Workflow Approval Rules (Rule 25.D)
  reviewerId String?
  reviewer   User?   @relation("ExpenseReviewedBy", fields: [reviewerId], references: [id])

  approverId String?
  approver   User?   @relation("ExpenseApprovedBy", fields: [approverId], references: [id])
}

model ExpenseBreakdownItem {
  id                  String             @id @default(cuid())
  expenseId           String
  expense             Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  description         String
  specification       String?
  quantity            Float
  unit                String
  unitCost            Float
  totalCost           Float
  supplierName        String?
  purchaseReferenceNo String?
  receiptInvoiceNo    String?
  purchaseDate        DateTime?
  remarks             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  proofFiles          ExpenseProofFile[]
}

model ExpenseProofFile {
  id              String                @id @default(cuid())
  expenseId       String
  expense         Expense               @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  breakdownItemId String?
  breakdownItem   ExpenseBreakdownItem? @relation(fields: [breakdownItemId], references: [id], onDelete: Cascade)
  fileName        String
  fileType        String
  fileUrl         String
  fileHash        String?
  uploadedById    String
  uploadedBy      User                  @relation("ExpenseProofUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt      DateTime              @default(now())
  verifiedById    String?
  verifiedBy      User?                 @relation("ExpenseProofVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  status          String                @default("UPLOADED")
}

model ExpenseAIValidation {
  id                   String   @id @default(cuid())
  expenseId            String   @unique
  expense              Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  validationStatus     String // Passed, Needs Review, Rejected, Incomplete, Possible Duplicate, Over Budget, Missing Proof of Purchase
  validationScore      Float?
  findings             String?
  recommendations      String?
  duplicateWarning     Boolean  @default(false)
  budgetWarning        Boolean  @default(false)
  scopeAlignmentResult String?
  createdAt            DateTime @default(now())
}

model ExpenseApprovalLog {
  id             String   @id @default(cuid())
  expenseId      String
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action         String
  actionByUserId String
  actionByUser   User     @relation("ExpenseApprovalActionBy", fields: [actionByUserId], references: [id])
  comments       String?
  previousStatus String?
  newStatus      String?
  createdAt      DateTime @default(now())
}

model PettyCashAccount {
  id                   String  @id @default(cuid())
  accountName          String // e.g., "Main Office Petty Cash", "Site A Petty Cash"
  department           String?
  fundLimit            Float
  replenishmentTrigger Float?
  currentBalance       Float // Automatically calculated/updated

  // Relationships
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  custodianId String
  custodian   User   @relation("PCCustodian", fields: [custodianId], references: [id])

  approverId String?
  approver   User?   @relation("PCApprover", fields: [approverId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("PCReviewer", fields: [reviewerId], references: [id])

  expenses       PettyCashExpense[]
  replenishments PettyCashReplenishment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PettyCashExpense {
  id                 String   @id @default(cuid())
  date               DateTime
  payee              String
  purpose            String
  category           String // Meals, Fuel, Toll, Supplies, etc.
  amount             Float
  isVat              Boolean  @default(false)
  netAmount          Float    @default(0)
  vatAmount          Float    @default(0)
  billingEligibility String   @default("BILLABLE") // BILLABLE, NON_BILLABLE, FOR_VALIDATION, FOR_VARIATION
  receiptNumber      String?
  attachmentUrl      String?
  isNoReceipt        Boolean  @default(false)
  remarks            String?
  status             String   @default("PENDING") // PENDING, LIQUIDATED, REJECTED

  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  // The account this was drawn from
  accountId String
  account   PettyCashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // The project it was charged to
  projectId String?
  // We don't strictly require a relation to Project if we just want to log the name, but linking it is better.

  // The replenishment batch it belongs to (if any)
  replenishmentId String?
  replenishment   PettyCashReplenishment? @relation(fields: [replenishmentId], references: [id])

  costType String @default("DIRECT") // DIRECT, INDIRECT, GENERAL, TEMPORARY, REIMBURSABLE

  awardedBoqItemId String?
  awardedBoqItem   AwardedBOQItem? @relation(fields: [awardedBoqItemId], references: [id])

  consolidatedBoqItemId String?
  consolidatedBoqItem   ConsolidatedBOQItem? @relation(fields: [consolidatedBoqItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PettyCashReplenishment {
  id            String @id @default(cuid())
  requestNumber String @unique
  status        String @default("DRAFT") // DRAFT, SUBMITTED, FINANCE_REVIEW, FOR_APPROVAL, APPROVED, RELEASED, CLOSED

  fundLimit        Float
  beginningBalance Float
  totalExpenses    Float
  cashOnHand       Float
  amountRequested  Float

  reviewerAction  String? // ACCEPT, REJECT, RETURN, ADJUST
  reviewerRemarks String?

  approverId   String?
  approvalDate DateTime?

  releaseDate  DateTime?
  releaseMode  String? // Cash, Bank, Check, GCash
  releaseRefNo String?
  receiverId   String?

  accountId String
  account   PettyCashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  expenses PettyCashExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id              String    @id @default(cuid())
  workerId        String?   @unique // Custom Employee No.
  firstName       String
  lastName        String
  middleName      String?
  suffix          String?
  nickname        String?
  dateOfBirth     DateTime?
  gender          String?
  civilStatus     String?
  mobileNumber    String?
  emailAddress    String?
  completeAddress String?

  emergencyContactName     String?
  emergencyContactNumber   String?
  emergencyContactRelation String?

  // Employment / Engagement Type
  employmentType            String    @default("PROJECT_BASED") // REGULAR, PROJECT_BASED, CONTRACTUAL, PROBATIONARY, DAILY_WORKER, MONTHLY_EMPLOYEE, HOURLY_WORKER, PIECE_RATE_WORKER, FREELANCE_CONSULTANT, ONE_LOT_WORKER, RETAINER_CONSULTANT, TEMPORARY_WORKER, OTHER
  workerCategory            String    @default("SKILLED") // SKILLED, HELPER, FOREMAN, SUPERVISOR, DRIVER, OPERATOR, ENGINEER, ADMIN, ACCOUNTING, WAREHOUSE, SAFETY_OFFICER, CONSULTANT, FREELANCER, OTHER
  designation               String? // e.g., Carpenter, Mason, Foreman, Laborer
  department                String?
  dateHired                 DateTime?
  engagementStartDate       DateTime?
  contractEndDate           DateTime?
  employmentStatus          String    @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED, TERMINATED, ON_LEAVE, SUSPENDED, COMPLETED_CONTRACT
  restDay                   String?
  standardWorkHours         Float?    @default(8)
  overtimeEligible          Boolean   @default(true)
  nightDifferentialEligible Boolean   @default(true)
  holidayPayEligible        Boolean   @default(true)
  subjectToAttendance       Boolean   @default(true)
  subjectToPayrollCutoff    Boolean   @default(true)

  // Rate Type and Compensation
  rateType            String  @default("DAILY_RATE") // DAILY_RATE, MONTHLY_SALARY, HOURLY_RATE, PIECE_RATE, ONE_LOT, PROFESSIONAL_FEE, RETAINER_FEE
  basicMonthlySalary  Float   @default(0)
  dailyRate           Float   @default(0)
  hourlyRate          Float   @default(0)
  pieceRate           Float   @default(0)
  unitDescription     String?
  contractAmount      Float   @default(0)
  professionalFee     Float   @default(0)
  paymentBasis        String? // ONE_TIME, PROGRESS_BILLING, MILESTONE, PERCENTAGE_ACCOMPLISHMENT
  billingFrequency    String? // PER_CUTOFF, MONTHLY, PER_DELIVERABLE, PER_INVOICE, ONE_TIME
  prorationMethod     String? // FIXED_PER_CUTOFF, CALENDAR_DAYS, WORKING_DAYS, ATTENDANCE_BASED
  retentionPercentage Float   @default(0)
  withholdingTaxRate  Float   @default(0)
  allowance           Float   @default(0)

  // Government IDs
  tinNumber         String?
  sssNumber         String?
  philHealthNumber  String?
  pagIbigNumber     String?
  umidNumber        String?
  nationalIdNumber  String?
  validIdType       String?
  validIdNumber     String?
  validIdExpiryDate DateTime?

  // Payroll Deductions & Taxes
  withholdingTaxEnabled           Boolean @default(false)
  sssDeductionEnabled             Boolean @default(false)
  philHealthDeductionEnabled      Boolean @default(false)
  pagibigDeductionEnabled         Boolean @default(false)
  otherGovernmentDeductionEnabled Boolean @default(false)

  taxClassification       String  @default("COMPENSATION_EMPLOYEE") // COMPENSATION_EMPLOYEE, MINIMUM_WAGE_EARNER, CONSULTANT_PROFESSIONAL, SUPPLIER_CONTRACTOR, NON_TAXABLE, TAX_EXEMPT
  withholdingTaxType      String  @default("COMPENSATION_WITHHOLDING_TAX") // COMPENSATION_WITHHOLDING_TAX, EXPANDED_WITHHOLDING_TAX, FINAL_TAX, NONE
  taxExemptionReason      String?
  birFormType             String?
  registeredBusinessName  String?
  officialReceiptRequired Boolean @default(false)
  taxStatus               String  @default("SINGLE") // Legacy field for backward compat

  // Bank and Payment Details
  payrollMode String @default("CASH") // CASH, BANK_TRANSFER, GCASH, CHECK, SUPPLIER_CONSULTANT_BILLING

  // NEW PAYMENT RULE FIELDS
  payrollCategory      String? @default("Other") // Weekly Salaried, Semi-Monthly, Monthly, 1-Lot Consultant, Freelance Consultant, Other
  allowedPaymentMethod String? @default("Manual Hold") // GCash Only, Bank Transfer Only, Manual Hold

  // GCash Info
  gcashAccountName          String?
  gcashNumber               String?
  gcashVerificationStatus   String?   @default("Pending") // Pending, Verified, Invalid, On Hold
  gcashSupportingAttachment String?
  gcashUpdatedBy            String?
  gcashApprovedBy           String?
  gcashLastUpdatedDate      DateTime?

  // Bank Info
  bankName                 String?
  bankBranch               String?
  bankAccountName          String?
  bankAccountNumber        String?
  bankAccountType          String?
  bankVerificationStatus   String?   @default("Pending") // Pending, Verified, Invalid, On Hold
  bankSupportingAttachment String?
  bankUpdatedBy            String?
  bankApprovedBy           String?
  bankLastUpdatedDate      DateTime?

  // Payment Profile Control
  paymentProfileStatus String? @default("Pending") // Pending, Verified, Invalid, On Hold
  paymentHoldReason    String?
  paymentRemarks       String?

  checkPayeeName   String?
