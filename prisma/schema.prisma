  instaPayEnabled Boolean   @default(false)
  pesonetEnabled  Boolean   @default(false)
  lastSyncedDate  DateTime?
  status          String    @default("ACTIVE")
  rawApiReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentFallbackRecommendation {
  id                    String    @id @default(cuid())
  payslipNumber         String?
  workerId              String
  worker                Worker    @relation(fields: [workerId], references: [id])
  amount                Float
  originalIntendedRoute String    @default("InstaPay")
  fallbackRoute         String    @default("PESONet")
  fallbackReason        String
  originalInstaPayRef   String?
  recommendedBy         String // System, AI, Finance
  approvalStatus        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById          String?
  approvalDate          DateTime?
  remarks               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id           String  @id @default(cuid())
  templateName String // e.g. "Progress Billing", "Certificate of Payment"
  templateType String // e.g. "PROGRESS_BILLING", "CERTIFICATE_OF_PAYMENT"
  fileUrl      String
  fileName     String
  parsedData   Json?
  isLocked     Boolean @default(false)
  uploadedById String?
  uploadedBy   User?   @relation("DocumentTemplateUploader", fields: [uploadedById], references: [id])
  status       String  @default("ACTIVE")

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectAccomplishmentFile {
  id               String  @id @default(cuid())
  projectId        String
  project          Project @relation(fields: [projectId], references: [id])
  billingId        String?
  fileName         String
  originalFilePath String
  workingFilePath  String?
  fileSize         Int
  fileType         String
  fileVersion      Int     @default(1)

  uploadedById String?
  uploadedBy   User?   @relation("AccomplishmentFileUploader", fields: [uploadedById], references: [id])

  status           String  @default("ACTIVE")
  isLockedOriginal Boolean @default(true)
  remarks          String?

  findings ProjectAccomplishmentAIFinding[]
  versions ProjectAccomplishmentFileVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // This is required to satisfy the "user" relation referenced in the error log
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

model ProjectAccomplishmentFileVersion {
  id            String                    @id @default(cuid())
  fileId        String
  file          ProjectAccomplishmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNumber Int
  filePath      String
  savedBy       String?
  savedAt       DateTime                  @default(now())
  remarks       String?
}

model ProjectAccomplishmentAIFinding {
  id             String                    @id @default(cuid())
  fileId         String
  file           ProjectAccomplishmentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project                   @relation(fields: [projectId], references: [id])
  billingId      String?
  findingType    String
  sheetName      String?
  cellReference  String?
  description    String
  severity       String                    @default("INFO")
  recommendation String?

  createdAt DateTime @default(now())
}

model KnowledgeRuleReference {
  id               String   @id @default(cuid())
  notebookName     String
  moduleName       String
  ruleCategory     String
  ruleTitle        String
  ruleDescription  String
  affectedProcess  String?
  validationType   String?
  severity         String   @default("BLOCK")
  isMandatory      Boolean  @default(true)
  effectiveDate    DateTime @default(now())
  lastReviewedDate DateTime?
  sourceLink       String?
  createdBy        String?
  updatedBy        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model KnowledgeRuleAuditLog {
  id                 String   @id @default(cuid())
  transactionId      String?
  moduleName         String
  notebookName       String
  ruleApplied        String
  validationResult   String
  actionTaken        String
  userAction         String?
  overrideRequested  Boolean  @default(false)
  overrideApprovedBy String?
  overrideReason     String?
  timestamp          DateTime @default(now())
}

