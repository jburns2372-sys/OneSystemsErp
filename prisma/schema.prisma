generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DIRECT_URL")
}

model User {
  id                           String                        @id @default(cuid())
  name                         String?
  email                        String?                       @unique
  password                     String?
  emailVerified                DateTime?
  image                        String?
  role                         String                        @default("PROJECT_ENGINEER")
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  passwordHash                 String?
  status                       String                        @default("ACTIVE")
  defaultRole                  String?
  department                   String?
  lastLoginAt                  DateTime?
  aiExecutiveQueries           AIExecutiveQuery[]            @relation("AIExecutiveQueries")
  aiApprovedReports            AIGeneratedReport[]           @relation("AIApprovedReports")
  aiReviewedReports            AIGeneratedReport[]           @relation("AIReviewedReports")
  aiGeneratedReports           AIGeneratedReport[]           @relation("AIGeneratedReports")
  aiReportEditors              AIGeneratedReportVersion[]    @relation("AIReportEditors")
  aiValidationLogs             AIValidationLog[]             @relation("AIValidationLogs")
  validationReviewedBy         AIValidationRecord[]          @relation("ValidationReviewedBy")
  validationCreatedBy          AIValidationRecord[]          @relation("ValidationCreatedBy")
  auditLogs                    AuditLog[]                    @relation("AuditLogs")
  preparedCanvassForms         CanvassForm[]                 @relation("CanvassPreparedBy")
  consumptionsLogged           ConsumptionLog[]
  encodedDtrs                  DailyTimeRecord[]             @relation("DtrEncoder")
  approvedDeductions           DeductionLedger[]             @relation("DeductionApprover")
  approvedDeliveries           Delivery[]                    @relation("DeliveryApprover")
  reviewedDeliveries           Delivery[]                    @relation("DeliveryReviewer")
  verifiedDeliveries           Delivery[]                    @relation("DeliveryVerifier")
  deliveriesReceived           Delivery[]                    @relation("DeliveryReceiver")
  uploadedDocs                 Document[]                    @relation("DocumentUploader")
  uploadedTemplates            DocumentTemplate[]            @relation("DocumentTemplateUploader")
  deploymentsApproved          EquipmentDeployment[]         @relation("DeploymentApprovedBy")
  deploymentsRequested         EquipmentDeployment[]         @relation("DeploymentRequestedBy")
  executiveAccessLogs          ExecutiveAccessLog[]          @relation("ExecutiveAccessLogs")
  executiveDashboardPreference ExecutiveDashboardPreference?
  approvedExpenses             Expense[]                     @relation("ExpenseApprovedBy")
  reviewedExpenses             Expense[]                     @relation("ExpenseReviewedBy")
  expenses                     Expense[]                     @relation("ExpenseLoggedBy")
  approvalActions              ExpenseApprovalLog[]          @relation("ExpenseApprovalActionBy")
  verifiedProofFiles           ExpenseProofFile[]            @relation("ExpenseProofVerifiedBy")
  uploadedProofFiles           ExpenseProofFile[]            @relation("ExpenseProofUploadedBy")
  misReleased                  MaterialIssuance[]            @relation("MISReleaser")
  misApproved                  MaterialIssuance[]            @relation("MISAccountant")
  misProcessed                 MaterialIssuance[]            @relation("MISWarehouseman")
  misCreated                   MaterialIssuance[]            @relation("MISForeman")
  approvedMRs                  MaterialRequest[]             @relation("ApprovedBy")
  checkedMRs                   MaterialRequest[]             @relation("CheckedBy")
  preparedMRs                  MaterialRequest[]             @relation("PreparedBy")
  materialRequests             MaterialRequest[]             @relation("RequestedBy")
  mrsProcessed                 MaterialReturn[]              @relation("MRSWarehouseman")
  mrsCreated                   MaterialReturn[]              @relation("MRSForeman")
  payrollApproverLogs          PayrollApproval[]             @relation("PayrollApproverLog")
  approvedPayrolls             PayrollPeriod[]               @relation("PayrollApprover")
  createdPayrolls              PayrollPeriod[]               @relation("PayrollCreator")
  pcReviewers                  PettyCashAccount[]            @relation("PCReviewer")
  pcApprovers                  PettyCashAccount[]            @relation("PCApprover")
  pcCustodians                 PettyCashAccount[]            @relation("PCCustodian")
  managedProjects              Project[]                     @relation("ProjectManager")
  projectAccomplishmentFiles   ProjectAccomplishmentFile[]
  uploadedAccomplishmentFiles  ProjectAccomplishmentFile[]   @relation("AccomplishmentFileUploader")
  approvedPOs                  PurchaseOrder[]               @relation("POApprovedBy")
  reviewedPOs                  PurchaseOrder[]               @relation("POReviewedBy")
  preparedPOs                  PurchaseOrder[]               @relation("POPreparedBy")
  userLoginLogs                UserLoginLog[]                @relation("UserLoginLogs")
  userRoles                    UserRole[]
  validationAuditLogs          ValidationAuditLog[]          @relation("ValidationAuditLogs")
  evidencePackCreator          ValidationEvidencePack[]      @relation("EvidencePackCreator")
  validationSettingsUpdatedBy  ValidationSettings[]          @relation("ValidationSettingsUpdatedBy")
  uploadedWorkerDocs           WorkerDocument[]              @relation("WorkerDocumentUploader")
  assignedScheduleActivities   ScheduleActivity[]            @relation("ActivityAssignedTo")
  reportedScheduleProgress     ScheduleProgressUpdate[]      @relation("ActivityReportedBy")
  reportedScheduleDelays       ScheduleDelayRecord[]         @relation("DelayReportedBy")
  projectAssignments           ProjectUserAssignment[]
  uploadedAiSources            AiKnowledgeSource[]           @relation("AiKnowledgeSourceUploader")
  chatbotLogs                  AiAccessAuditLog[]            @relation("UserAiAuditLogs")
  chatbotFeedbacks             ChatbotFeedback[]             @relation("UserChatbotFeedbacks")
  chatSessions                 AiChatSession[]               @relation("UserAiChatSessions")
  chatMessages                 AiChatMessage[]               @relation("UserAiChatMessages")
}

model SystemRole {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Project {
  id                              String                           @id @default(cuid())
  name                            String
  description                     String?
  location                        String?
  startDate                       DateTime?
  endDate                         DateTime?
  status                          String                           @default("PLANNING")
  contractAmountVATInclusive      Boolean                          @default(true)
  vatRate                         Float                            @default(12.0)
  retentionPercentage             Float                            @default(10.0)
  withholdingTaxPercentage        Float                            @default(2.0)
  mobilizationAdvanceAmount       Float                            @default(0)
  advanceRecoupmentMethod         String                           @default("PRO_RATA")
  liquidatedDamagesRate           Float                            @default(0.1)
  otherDeductions                 Float                            @default(0)
  paymentTerms                    String?
  boqLocked                       Boolean                          @default(false)
  consolidatedBOQLocked           Boolean                          @default(false)
  procurementBenchmarkLocked      Boolean                          @default(false)
  contractNumber                  String?
  client                          String?
  contractor                      String?
  gpsLatitude                     Float?
  gpsLongitude                    Float?
  acceptableGeotagRadius          Float                            @default(100)
  projectCategory                 String?
  fundingSource                   String?
  contractAmount                  Float                            @default(0)
  originalContractDuration        Int?
  noticeToProceedDate             DateTime?
  originalCompletionDate          DateTime?
  revisedCompletionDate           DateTime?
  implementingOffice              String?
  managerId                       String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  projectValidations              AIValidationRecord[]             @relation("ProjectValidations")
  aiValidationRuns                AIValidationRun[]
  accomplishments                 Accomplishment[]
  awardedBoqItems                 AwardedBOQItem[]
  procurementBenchmarkItems       ProcurementBenchmarkItem[]
  backCharges                     BackCharge[]
  billings                        Billing[]
  canvassForms                    CanvassForm[]
  consolidatedBoqItems            ConsolidatedBOQItem[]
  consumptions                    ConsumptionLog[]
  dtrs                            DailyTimeRecord[]
  documents                       Document[]
  documentTemplates               DocumentTemplate[]
  equipmentDeployments            EquipmentDeployment[]
  equipmentUtilizations           EquipmentUtilization[]
  evidenceFiles                   EvidenceFile[]
  expenses                        Expense[]
  fleetTrips                      FleetTrip[]
  geofences                       Geofence[]
  jobOrders                       JobOrder[]
  knowledgeReferences             KnowledgeReference[]
  issuances                       MaterialIssuance[]
  materialRequests                MaterialRequest[]
  materialReturns                 MaterialReturn[]
  payrolls                        Payroll[]
  payrollPeriods                  PayrollPeriod[]
  pettyCashAccounts               PettyCashAccount[]
  manager                         User?                            @relation("ProjectManager", fields: [managerId], references: [id])
  projectAccomplishmentAIFindings ProjectAccomplishmentAIFinding[]
  projectAccomplishmentFiles      ProjectAccomplishmentFile[]
  projectCameras                  ProjectCamera[]
  projectValidationScore          ProjectValidationScore?          @relation("ProjectValidationScores")
  subcontractBillings             SubcontractBilling[]
  subcontractPackages             SubcontractPackage[]
  projectEvidencePacks            ValidationEvidencePack[]         @relation("ProjectEvidencePacks")
  variationOrders                 VariationOrder[]
  workers                         Worker[]                         @relation("ProjectWorkers")
  projectCostLedgers              ProjectCostLedger[]              @relation("ProjectCostLedgers")
  commitmentLedgers               CommitmentLedger[]               @relation("ProjectCommitmentLedgers")
  subcontractorVariationOrders    SubcontractorVariationOrder[]    @relation("ProjectSubcontractorVOs")
  clientVariationOrders           ClientVariationOrder[]           @relation("ProjectClientVOs")
  valueEngineeringRecords         ValueEngineeringRecord[]         @relation("ProjectVERecords")
  projectSchedule                 ProjectSchedule?
  userAssignments                 ProjectUserAssignment[]
}

model ProjectUserAssignment {
  id               String    @id @default(cuid())
  userId           String
  projectId        String
  projectRole      String
  accessLevel      String
  assignmentStatus String    @default("active")
  assignedBy       String?
  dateAssigned     DateTime  @default(now())
  dateRemoved      DateTime?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@index([assignmentStatus])
}

model AwardedBOQItem {
  id                             String                        @id @default(cuid())
  itemCode                       String
  category                       String?
  description                    String
  unit                           String
  quantity                       Float
  directCost                     Float                         @default(0)
  indirectCost                   Float                         @default(0)
  combinedUnitCost               Float                         @default(0)
  totalCost                      Float
  previousQuantityAccomplished   Float                         @default(0)
  currentQuantityAccomplished    Float                         @default(0)
  totalQuantityAccomplished      Float                         @default(0)
  remainingQuantity              Float                         @default(0)
  percentageAccomplished         Float                         @default(0)
  amountAccomplished             Float                         @default(0)
  balanceAmount                  Float                         @default(0)
  approvedClientVoQuantity       Float                         @default(0)
  revisedContractQuantity        Float                         @default(0)
  revisedContractUnitPrice       Float                         @default(0)
  revisedContractAmount          Float                         @default(0)
  previousBilledQuantity         Float                         @default(0)
  currentBillingQuantity         Float                         @default(0)
  totalBilledQuantity            Float                         @default(0)
  revenueRecognized              Float                         @default(0)
  actualOrderedQuantity          Float                         @default(0)
  actualDeliveredQuantity        Float                         @default(0)
  actualInstalledQuantity        Float                         @default(0)
  finalApprovedInstalledQuantity Float?
  materialSavingsQuantity        Float                         @default(0)
  materialSavingsAmount          Float                         @default(0)
  wastageQuantity                Float                         @default(0)
  actualCost                     Float                         @default(0)
  costVariance                   Float                         @default(0)
  aiValidationRequired           Boolean                       @default(true)
  requiredEvidenceType           String?
  status                         String                        @default("PENDING")
  processingType                 String                        @default("MATERIAL_EQUIPMENT")
  projectId                      String
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  aiValidationRuns               AIValidationRun[]
  accomplishmentItems            AccomplishmentItem[]
  project                        Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lotBreakdowns                  BOQLotBreakdown[]
  mappings                       BOQMapping[]
  billingItems                   BillingItem[]
  evidenceFiles                  EvidenceFile[]
  expenses                       Expense[]
  pettyCashExpenses              PettyCashExpense[]
  subcontractorBOQItems          SubcontractorBOQItem[]
  variationOrderItems            VariationOrderItem[]
  projectCostLedgers             ProjectCostLedger[]           @relation("AwardedCostLedgers")
  commitmentLedgers              CommitmentLedger[]            @relation("AwardedCommitmentLedgers")
  subcontractorVariationOrders   SubcontractorVariationOrder[] @relation("AwardedSubcontractorVOs")
  clientVariationOrders          ClientVariationOrder[]        @relation("AwardedClientVOs")
  valueEngineeringRecords        ValueEngineeringRecord[]      @relation("AwardedVERecords")
  scheduleMappings               ScheduleBOQMapping[]
}

model ProcurementBenchmarkItem {
  id          String  @id @default(cuid())
  itemCode    String
  category    String?
  description String
  unit        String
  quantity    Float
  unitCost    Float
  totalCost   Float
  status      String  @default("PENDING")
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ConsolidatedBOQItem {
  id                           String                        @id @default(cuid())
  itemCode                     String
  category                     String?
  description                  String
  unit                         String
  quantity                     Float
  unitCost                     Float
  totalCost                    Float
  status                       String                        @default("PENDING")
  projectId                    String
  deliveredQty                 Float                         @default(0)
  consumedQty                  Float                         @default(0)
  voAdditiveQty                Float                         @default(0)
  voDeductiveQty               Float                         @default(0)
  revisedQuantity              Float                         @default(0)
  voAdditiveCost               Float                         @default(0)
  voDeductiveCost              Float                         @default(0)
  revisedTotalCost             Float                         @default(0)
  wasteAllowance               Float                         @default(0)
  revisedBenchmarkUnitCost     Float                         @default(0)
  requestedQuantity            Float                         @default(0)
  purchasedQuantity            Float                         @default(0)
  issuedQuantity               Float                         @default(0)
  subcontractedQuantity        Float                         @default(0)
  jobOrderQuantity             Float                         @default(0)
  subcontractorVoQuantity      Float                         @default(0)
  remainingBenchmarkQuantity   Float                         @default(0)
  actualUnitCost               Float                         @default(0)
  actualCost                   Float                         @default(0)
  committedCost                Float                         @default(0)
  quantityVariance             Float                         @default(0)
  costVariance                 Float                         @default(0)
  savings                      Float                         @default(0)
  overrun                      Float                         @default(0)
  valueEngineeringSavings      Float                         @default(0)
  isVariationItem              Boolean                       @default(false)
  sourceVoNumber               String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  mappings                     BOQMapping[]
  canvassItems                 CanvassItem[]
  project                      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consumptionItems             ConsumptionItem[]
  deliveryItems                DeliveryItem[]
  expenses                     Expense[]
  issuanceItems                IssuanceItem[]
  mrItems                      MaterialRequestItem[]
  pettyCashExpenses            PettyCashExpense[]
  poItems                      PurchaseOrderItem[]
  returnItems                  ReturnItem[]
  projectCostLedgers           ProjectCostLedger[]           @relation("ConsolidatedCostLedgers")
  commitmentLedgers            CommitmentLedger[]            @relation("ConsolidatedCommitmentLedgers")
  subcontractorVariationOrders SubcontractorVariationOrder[] @relation("ConsolidatedSubcontractorVOs")
  valueEngineeringRecords      ValueEngineeringRecord[]      @relation("ConsolidatedVERecords")
  subcontractPackages          SubcontractPackage[]          @relation("ConsolidatedSubcontractPackages")
  jobOrders                    JobOrder[]                    @relation("ConsolidatedJobOrders")
}

model BOQMapping {
  id                    String              @id @default(cuid())
  mappingType           String
  allocationPercentage  Float?
  allocationQuantity    Float?
  remarks               String?
  aiConfidenceScore     Float?
  status                String              @default("APPROVED")
  awardedBoqItemId      String
  consolidatedBoqItemId String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  consolidatedBoqItem   ConsolidatedBOQItem @relation(fields: [consolidatedBoqItemId], references: [id], onDelete: Cascade)
  awardedBoqItem        AwardedBOQItem      @relation(fields: [awardedBoqItemId], references: [id], onDelete: Cascade)
}

model Supplier {
  id              String              @id @default(cuid())
  name            String
  tin             String?
  contactPerson   String?
  contactNumber   String?
  email           String?
  address         String?
  paymentTerms    String?
  website         String?
  plantLocation   String?
  isVatable       Boolean             @default(true)
  isSeedData      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  accountsPayable AccountsPayable[]
  purchaseOrders  PurchaseOrder[]
  quotations      SupplierQuotation[]
}

model MaterialRequest {
  id                String                @id @default(cuid())
  mrNumber          String                @unique
  status            String                @default("DRAFT")
  projectId         String
  requesterId       String
  preparerId        String?
  checkerId         String?
  approverId        String?
  purpose           String?
  priority          String                @default("NORMAL")
  locationOfUse     String?
  remarks           String?
  aiValidationRisk  String?
  aiValidationNotes String?
  dateNeeded        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  canvassForms      CanvassForm[]
  approver          User?                 @relation("ApprovedBy", fields: [approverId], references: [id])
  checker           User?                 @relation("CheckedBy", fields: [checkerId], references: [id])
  preparer          User?                 @relation("PreparedBy", fields: [preparerId], references: [id], onDelete: Cascade)
  requester         User                  @relation("RequestedBy", fields: [requesterId], references: [id])
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             MaterialRequestItem[]
  purchaseOrders    PurchaseOrder[]
}

model MaterialRequestItem {
  id                    String              @id @default(cuid())
  quantity              Float
  approvedQuantity      Float?
  mrId                  String
  consolidatedBoqItemId String
  breakdownData         Json?
  consolidatedBoqItem   ConsolidatedBOQItem @relation(fields: [consolidatedBoqItemId], references: [id], onDelete: Cascade)
  mr                    MaterialRequest     @relation(fields: [mrId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  status           String              @default("DRAFT")
  supplierId       String
  mrId             String
  totalAmount      Float               @default(0)
  netAmount        Float               @default(0)
  vatAmount        Float               @default(0)
  deliveryDate     DateTime?
  paymentTermsDays Int?
  dueDate          DateTime?
  preparerId       String?
  reviewerId       String?
  approverId       String?
  aiValidationRisk String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  canvassFormId    String?
  payables         AccountsPayable[]
  deliveries       Delivery[]
  canvassForm      CanvassForm?        @relation(fields: [canvassFormId], references: [id], onDelete: Cascade)
  approver         User?               @relation("POApprovedBy", fields: [approverId], references: [id])
  reviewer         User?               @relation("POReviewedBy", fields: [reviewerId], references: [id])
  preparer         User?               @relation("POPreparedBy", fields: [preparerId], references: [id], onDelete: Cascade)
  mr               MaterialRequest     @relation(fields: [mrId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items            PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id                    String              @id @default(cuid())
  quantity              Float
  unitCost              Float
  poId                  String
  consolidatedBoqItemId String
  consolidatedBoqItem   ConsolidatedBOQItem @relation(fields: [consolidatedBoqItemId], references: [id], onDelete: Cascade)
  po                    PurchaseOrder       @relation(fields: [poId], references: [id], onDelete: Cascade)
}

model Expense {
  id                    String                 @id @default(cuid())
  amount                Float
  totalBreakdownAmount  Float                  @default(0)
  date                  DateTime
  category              String
  description           String
  receiptRef            String?
  supplierName          String?
  isAccrued             Boolean                @default(false)
  netAmount             Float                  @default(0)
  vatAmount             Float                  @default(0)
  billingEligibility    String                 @default("BILLABLE")
  status                String                 @default("DRAFT")
  aiValidationStatus    String?
  approvalStatus        String?
  aiValidationRisk      String?
  projectId             String
  loggedById            String
  costType              String                 @default("DIRECT")
  awardedBoqItemId      String?
  consolidatedBoqItemId String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  reviewerId            String?
  approverId            String?
  approver              User?                  @relation("ExpenseApprovedBy", fields: [approverId], references: [id])
  reviewer              User?                  @relation("ExpenseReviewedBy", fields: [reviewerId], references: [id])
  consolidatedBoqItem   ConsolidatedBOQItem?   @relation(fields: [consolidatedBoqItemId], references: [id], onDelete: Cascade)
  awardedBoqItem        AwardedBOQItem?        @relation(fields: [awardedBoqItemId], references: [id], onDelete: Cascade)
  loggedBy              User                   @relation("ExpenseLoggedBy", fields: [loggedById], references: [id])
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiValidation          ExpenseAIValidation?
  approvalLogs          ExpenseApprovalLog[]
  breakdownItems        ExpenseBreakdownItem[]
  proofFiles            ExpenseProofFile[]
  pettyCashExpense      PettyCashExpense?
}

model ExpenseBreakdownItem {
  id                  String             @id @default(cuid())
  expenseId           String
  description         String
  specification       String?
  quantity            Float
  unit                String
  unitCost            Float
  totalCost           Float
  supplierName        String?
  purchaseReferenceNo String?
  receiptInvoiceNo    String?
  purchaseDate        DateTime?
  remarks             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  expense             Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  proofFiles          ExpenseProofFile[]
}

model ExpenseProofFile {
  id              String                @id @default(cuid())
  expenseId       String
  breakdownItemId String?
  fileName        String
  fileType        String
  fileUrl         String
  fileHash        String?
  uploadedById    String
  uploadedAt      DateTime              @default(now())
  verifiedById    String?
  verifiedAt      DateTime?
  status          String                @default("UPLOADED")
  verifiedBy      User?                 @relation("ExpenseProofVerifiedBy", fields: [verifiedById], references: [id], onDelete: Cascade)
  uploadedBy      User                  @relation("ExpenseProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  breakdownItem   ExpenseBreakdownItem? @relation(fields: [breakdownItemId], references: [id], onDelete: Cascade)
  expense         Expense               @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model ExpenseAIValidation {
  id                   String   @id @default(cuid())
  expenseId            String   @unique
  validationStatus     String
  validationScore      Float?
  findings             String?
  recommendations      String?
  duplicateWarning     Boolean  @default(false)
  budgetWarning        Boolean  @default(false)
  scopeAlignmentResult String?
  createdAt            DateTime @default(now())
  expense              Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model ExpenseApprovalLog {
  id             String   @id @default(cuid())
  expenseId      String
  action         String
  actionByUserId String
  comments       String?
  previousStatus String?
  newStatus      String?
  createdAt      DateTime @default(now())
  actionByUser   User     @relation("ExpenseApprovalActionBy", fields: [actionByUserId], references: [id], onDelete: Cascade)
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model PettyCashAccount {
  id                   String                   @id @default(cuid())
  accountName          String
  department           String?
  fundLimit            Float
  replenishmentTrigger Float?
  currentBalance       Float
  projectId            String?
  custodianId          String
  approverId           String?
  reviewerId           String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  reviewer             User?                    @relation("PCReviewer", fields: [reviewerId], references: [id])
  approver             User?                    @relation("PCApprover", fields: [approverId], references: [id])
  custodian            User                     @relation("PCCustodian", fields: [custodianId], references: [id], onDelete: Cascade)
  project              Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses             PettyCashExpense[]
  replenishments       PettyCashReplenishment[]
}

model PettyCashExpense {
  id                    String                  @id @default(cuid())
  date                  DateTime
  payee                 String
  purpose               String
  category              String
  amount                Float
  isVat                 Boolean                 @default(false)
  netAmount             Float                   @default(0)
  vatAmount             Float                   @default(0)
  billingEligibility    String                  @default("BILLABLE")
  receiptNumber         String?
  attachmentUrl         String?
  isNoReceipt           Boolean                 @default(false)
  remarks               String?
  status                String                  @default("PENDING")
  expenseId             String?                 @unique
  accountId             String
  projectId             String?
  replenishmentId       String?
  costType              String                  @default("DIRECT")
  awardedBoqItemId      String?
  consolidatedBoqItemId String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  consolidatedBoqItem   ConsolidatedBOQItem?    @relation(fields: [consolidatedBoqItemId], references: [id], onDelete: Cascade)
  awardedBoqItem        AwardedBOQItem?         @relation(fields: [awardedBoqItemId], references: [id], onDelete: Cascade)
  replenishment         PettyCashReplenishment? @relation(fields: [replenishmentId], references: [id], onDelete: Cascade)
  account               PettyCashAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
